{
  "name": "alarmify-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "npm run typecheck && firebase emulators:exec --only firestore --project demo-alarmify \"vitest run\"",
    "emulators": "npm run build && firebase emulators:start --only functions,firestore,auth --project demo-alarmify"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "re2": "^1.26.1",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.28.2",
    "globals": "^17.12.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
