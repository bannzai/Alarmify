{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9399
    },
    "firestore": {
      "port": 8580
    },
    "functions": {
      "port": 5501
    },
    "hub": {
      "port": 4700
    },
    "logging": {
      "port": 4800
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
