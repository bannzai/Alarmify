{
  "sourceLanguage" : "en",
  "strings" : {
    "Account" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント"
          }
        }
      }
    },
    "Account authentication is not available on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末ではアカウントの認証を利用できません。"
          }
        }
      }
    },
    "Account ID" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント ID"
          }
        }
      }
    },
    "Alarmify" : {
      "shouldTranslate" : false
    },
    "AlarmKit" : {
      "shouldTranslate" : false
    },
    "Alarms already scheduled on this iPhone remain. Cancel them from the alarm list if you no longer need them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone に登録済みのアラームは残っています。不要な場合はアラーム一覧から取り消してください。"
          }
        }
      }
    },
    "All of your data on the server will be deleted. This cannot be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上のデータがすべて削除され、取り消せません。"
          }
        }
      }
    },
    "Allow alarms" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームの権限を許可する"
          }
        }
      }
    },
