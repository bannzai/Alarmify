    "All of your data on the server will be deleted. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف جميع بياناتك على الخادم. لا يمكن التراجع عن ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les teves dades del servidor se suprimiran. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna tvoje data na serveru budou smazána. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dine data på serveren bliver slettet. Det kan ikke fortrydes."
