{
  "sourceLanguage" : "en",
  "strings" : {
    "A rest_command you can call from any automation" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のオートメーションから呼べる rest_command"
          }
        }
      }
    },
    "A webhook contact point that rings when an alert fires" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートの発火時に鳴らす Webhook 通知先"
          }
        }
      }
    },
    "A webhook notification that rings when a monitor goes down" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モニターがダウンした時に鳴らす Webhook 通知"
          }
        }
      }
    },
    "Account" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント"
          }
        }
      }
    },
    "Add the 'Get Contents of URL' action and set the URL." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「URL の内容を取得」アクションを追加し、URL を設定します"
          }
        }
      }
    },
    "Add the step at the end of the job. 'if: always()' also rings after a failure; 'if: failure()' rings only when something broke." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "job の末尾にステップを追加します。「if: always()」で失敗時にも鳴り、「if: failure()」なら失敗時だけ鳴ります"
          }
        }
      }
    },
    "Alarmify" : {
      "shouldTranslate" : false
    },
