    "Couldn't link purchases to your account. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر ربط عمليات الشراء بحسابك. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut vincular les compres al teu compte. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy se nepodařilo propojit s tvým účtem. Zkontroluj připojení a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb kunne ikke knyttes til din konto. Tjek forbindelsen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe konnten nicht mit deinem Konto verknüpft werden. Überprüfe deine Verbindung und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση των αγορών με τον λογαριασμό σου. Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron vincular las compras a tu cuenta. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron vincular las compras a tu cuenta. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostoksia ei voitu yhdistää tiliisi. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lier les achats à votre compte. Vérifiez votre connexion et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לקשר את הרכישות לחשבון שלך. בדוק את החיבור ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी खरीदारी को आपके खाते से लिंक नहीं किया जा सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupnje nije moguće povezati s tvojim računom. Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült összekapcsolni a vásárlásokat a fiókoddal. Ellenőrizd a kapcsolatot, majd próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian tidak dapat ditautkan ke akun kamu. Periksa koneksi dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile collegare gli acquisti al tuo account. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入をアカウントに結び付けられませんでした。通信状態を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 항목을 계정에 연결하지 못했어요. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian tidak dapat dipautkan ke akaun anda. Semak sambungan dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøpene kunne ikke knyttes til kontoen din. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aankopen konden niet aan je account worden gekoppeld. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć zakupów z twoim kontem. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível vincular as compras à sua conta. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível associar as compras à tua conta. Verifica a ligação e tenta novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-au putut asocia achizițiile cu contul tău. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связать покупки с вашей учётной записью. Проверьте подключение и попробуйте ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy sa nepodarilo prepojiť s tvojím účtom. Skontroluj pripojenie a skús to znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köpen kunde inte kopplas till ditt konto. Kontrollera anslutningen och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถเชื่อมโยงรายการซื้อกับบัญชีของคุณได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alımlar hesabına bağlanamadı. Bağlantını kontrol edip tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося пов’язати покупки з вашим обліковим записом. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể liên kết các giao dịch mua với tài khoản của bạn. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將購買項目連結至你的帳戶。請檢查連線，然後再試一次。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将购买项目关联到你的账户。请检查网络连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將購買項目連結至你的帳號。請檢查連線，然後再試一次。"
          }
        }
      }
