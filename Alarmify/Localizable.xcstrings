    },
    "Could not read the response from the server. Please try again later." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーからの応答を読み取れませんでした。時間をおいて試してください。"
          }
        }
      }
    },
    "Could not save the account credentials." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証情報を保存できませんでした。"
