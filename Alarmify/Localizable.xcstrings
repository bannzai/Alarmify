    "Store the token as the repository secret 'ALARMIFY_TOKEN'. 'gh secret set' prompts for the value, so the token stays out of your shell history." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンをリポジトリの secret「ALARMIFY_TOKEN」に登録します。「gh secret set」はプロンプトでトークンを貼り付けるため、シェルの履歴に残りません"
          }
        }
      }
    },
    "Test alarm" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストアラーム"
          }
        }
      }
