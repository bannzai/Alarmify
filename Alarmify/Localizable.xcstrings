    "Include this account ID when you request deletion by email." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدرج معرّف الحساب هذا عند طلب الحذف عبر البريد الإلكتروني."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclou aquest ID del compte quan sol·licitis la supressió per correu electrònic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při žádosti o smazání e-mailem uveď toto ID účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medtag dette konto-id, når du anmoder om sletning via e-mail."
