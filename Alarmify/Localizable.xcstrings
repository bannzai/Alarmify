    "Add the 'Get Contents of URL' action and set the URL." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف إجراء «الحصول على محتويات URL» واضبط عنوان URL."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix l’acció «Obtenir continguts de l’URL» i configura l’URL."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej akci „Načíst obsah URL“ a nastav URL."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj handlingen „Hent indhold fra URL“ og angiv URL’en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Aktion „Inhalte von URL abrufen“ hinzu und lege die URL fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε την ενέργεια «Λήψη περιεχομένου URL» και όρισε το URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la acción «Obtener contenido de URL» y configura la URL."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega la acción «Obtener contenido de URL» y configura la URL."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ”Hae URL:n sisältö” -toiminto ja määritä URL."
