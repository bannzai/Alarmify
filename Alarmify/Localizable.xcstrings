    "Alarms already scheduled on this iPhone remain. Cancel them from the alarm list if you no longer need them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظل المنبّهات المجدولة بالفعل على هذا الـiPhone. ألغِها من قائمة المنبّهات إذا لم تعد بحاجة إليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alarmes que ja estan programades en aquest iPhone es conservaran. Cancel·la-les des de la llista d’alarmes si ja no les necessites."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budíky již naplánované na tomto iPhonu zůstanou zachovány. Pokud je už nepotřebuješ, zruš je v seznamu budíků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmer, der allerede er planlagt på denne iPhone, forbliver. Annuller dem fra alarmlisten, hvis du ikke længere har brug for dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits auf diesem iPhone geplante Alarme bleiben bestehen. Wenn du sie nicht mehr benötigst, kannst du sie in der Alarmliste abbrechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συναγερμοί που έχουν ήδη προγραμματιστεί σε αυτό το iPhone παραμένουν. Αν δεν τους χρειάζεσαι πλέον, ακύρωσέ τους από τη λίστα συναγερμών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alarmas ya programadas en este iPhone permanecerán. Cancélalas desde la lista de alarmas si ya no las necesitas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alarmas ya programadas en este iPhone permanecerán. Cancélalas desde la lista de alarmas si ya no las necesitas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle iPhonelle jo ajastetut hälytykset säilyvät. Peruuta ne hälytyslistalta, jos et enää tarvitse niitä."
