          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתראות שכבר תוכננו ב‑iPhone הזה יישארו. אם אינך זקוק להן עוד, בטל אותן מרשימת ההתראות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर पहले से शेड्यूल किए गए अलार्म मौजूद रहेंगे। अगर आपको उनकी ज़रूरत नहीं है, तो अलार्म सूची से उन्हें रद्द करें।"
