    },
    "Alarms already scheduled on this iPhone remain. Cancel them from the alarm list if you no longer need them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone に登録済みのアラームは残っています。不要な場合はアラーム一覧から取り消してください。"
          }
        }
      }
    },
    "All of your data on the server will be deleted. This cannot be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
