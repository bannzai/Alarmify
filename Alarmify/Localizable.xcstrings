        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le même chemin qu’une notification push reçue (AlarmRequest → AlarmKitScheduler.apply) pour programmer ou annuler une alarme avec un identifiant fixe. Utilisez-le dans le simulateur, où simctl push n’emprunte pas ce chemin."
          }
        },
        "he" : {
          "stringUnit" : {
