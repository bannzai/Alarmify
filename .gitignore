.DS_Store
xcuserdata/
*.xcuserstate
build/
DerivedData/
tmp/
.claude/settings.local.json
.envrc
# simtunnel mcp-config が worktree ごとに書き込む接続設定 (セッション固有のためコミットしない)
.mcp.json
# bundler のローカルインストール先 (~/.bundle/config の path=vendor/bundle が作る)
vendor/bundle/

# スクリーンショット生成の中間出力先 (コミットしない)。apply_variant.sh で配置した fastlane/screenshots/ はコミット対象
artifacts/
scripts/generate_screenshots/artifacts/
scripts/generate_screenshots/temp_screenshots/
scripts/snapshot_ui_tests/screenshots/
# xcodebuild / swiftc で作った実行ファイルの実行時に作業ディレクトリへ出る LLVM のプロファイルデータ
*.profraw
node_modules/
firebase/functions/lib/
# Firebase CLI / Emulator Suite が作るログとキャッシュ
.firebase/
*-debug.log
# エミュレータ専用の Secret の値 (documents/revenuecat-webhook.md)。本番の値は Secret Manager にだけ置く
firebase/functions/.secret.local
# RevenueCat の実キー (appl_) を置くローカル上書き。実値をコミットしないため追跡しない (Config.xcconfig のコメント参照)
Config.local.xcconfig
